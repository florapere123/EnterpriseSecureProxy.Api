{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DataSource": "Mock",
  "ConnectionStrings": {
    "ProxyConfiguration": "Server= ;Database=EnterpriseSecureProxyDb;Trusted_Connection=True;TrustServerCertificate=True;Connection Timeout=15;Max Pool Size=100;Connection Lifetime=60;"
  },
  "Security": {
    "MasterKeyBase64": ""
  },
  "Downstream": {
    "UseMockHandler": true,
    "MaxConcurrentRequestsPerDestination": 32
  },
  "GatewayTrust": {
    "TrustGatewayHeaders": false
  },
  "RequestLimits": {
    "MaxGlobalBodyBytes": 5242880,
    "OperationKeyPeekBytes": 32768
  },
  "ProxyDefaults": {
    "DefaultMaxRequestSizeBytes": 1048576,
    "ConfigCacheMinutes": 5,
    "IdempotencyCacheMinutes": 5,
    "DefaultDestinationTimeoutSeconds": 20,
    "SlowDestinationTimeoutSeconds": 45
  }
}
