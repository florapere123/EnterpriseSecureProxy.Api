*.nuget.targets
*.nupkg
*.snupkg

# Publish / publish profiles (local)
publish/
*.pubxml
*.publishproj
PublishScripts/

# Test / coverage
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.VisualState.xml
TestResult.xml
nunit-*.xml
coverage*.json
coverage*.xml
coverage*.info
*.coverage
*.coveragexml

# --- Application logs & local databases ---
api-run.log
api-sql-run.log
*.log
*.db
*.db-shm
*.db-wal
*.mdf
*.ldf
*.ndf

# --- OS-specific ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# --- Secrets & local config overrides (never commit) ---
secrets.json
appsettings.*.local.json
*.Development.local.json
.env
.env.*
!.env.example

# --- IDE / tool caches ---
.idea/
*.rsuser
*.sln.iml
.cursor/

# --- Misc ---
*.swp
*~
*.bak